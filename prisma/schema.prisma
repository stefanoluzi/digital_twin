generator client {
  provider = "prisma-client-js"
}

model CoverageSnapshot {
  id Int @id @default(autoincrement())
  capturedAt DateTime @default(now())
  revision Int
  signature String
  total Int
  covered Int
  uncovered Int
  percent Int
  repair Int
  purchase Int
  groups CoverageSnapshotGroup[]
  @@index([capturedAt, id])
}

model CoverageSnapshotGroup {
  snapshotId Int
  dimension String
  key String
  name String
  responsibleId String?
  responsibleName String?
  areaIds String[]
  total Int
  covered Int
  uncovered Int
  percent Int
  repair Int
  purchase Int
  trackedSince DateTime?
  lastImprovedAt DateTime?
  snapshot CoverageSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  // Historical identity intentionally has no FK to mutable/deletable catalogs.
  @@id([snapshotId, dimension, key])
  @@index([dimension, key, snapshotId])
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Revision {
  id      Int @id
  version Int @default(0)
}

model Responsible {
  id     String @id
  name   String
  active Boolean
  areas  Area[]
  repairRequests RepairRequest[]
  rexExecutions RexExecution[]
}

model Area {
  id                    String @id
  code                  String @unique
  name                  String
  responsibleGmbId      String?
  migrationCandidateIds String[] @default([])
  responsible           Responsible? @relation(fields: [responsibleGmbId], references: [id], onDelete: Restrict)
  spares                Spare[]
  equipment             Equipment[]
  rexTasks              RexTask[]
}

model Category {
  id     String @id
  name   String
  spares Spare[]
}

model AppUser {
  id   String @id
  name String
  role String
}

model Equipment {
  id    String @id
  area  String
  name  String
  owner Area @relation(fields: [area], references: [id], onDelete: Restrict)
  spares SpareEquipment[]
  installedUnits Unit[]
  repairProfile RepairEquipmentProfile?
  repairRequests RepairRequest[]
  rexTasks RexTask[]
}

model RepairEquipmentProfile {
  equipmentId String @id
  idrep String @unique
  sector String
  trade String
  active Boolean @default(true)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
}

model RepairConfig {
  id Int @id
  revision Int @default(0)
  warningDays Int @default(7)
  blockCategories Json
  workshops String[]
}

model RepairRequest {
  id String @id @default(uuid())
  equipmentId String
  quantity Int
  targetMonth DateTime @db.Date
  requiredDate DateTime? @db.Date
  criticality String
  criticalReason String
  fixedDeadline Boolean
  criticalDueDate DateTime? @db.Date
  responsibleId String?
  workshop String
  notes String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  responsible Responsible? @relation(fields: [responsibleId], references: [id], onDelete: Restrict)
  items RepairItem[]
  events RepairEvent[]
  @@index([targetMonth, equipmentId])
  @@index([requiredDate, criticality])
  @@index([workshop, responsibleId])
}

model RepairItem {
  id String @id @default(uuid())
  requestId String
  ordinal Int
  status String @default("PENDING")
  startedAt DateTime? @db.Date
  sentAt DateTime? @db.Date
  request RepairRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  commitments RepairCommitment[]
  blocks RepairBlock[]
  delivery RepairDelivery?
  @@unique([requestId, ordinal])
  @@index([status])
}

model RepairCommitment {
  id String @id @default(uuid())
  itemId String
  date DateTime @db.Date
  reason String
  recordedAt DateTime @default(now())
  actor String
  sequence Int
  item RepairItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  @@unique([itemId, sequence])
}

model RepairBlock {
  id String @id @default(uuid())
  itemId String
  startedAt DateTime @db.Date
  resolvedAt DateTime? @db.Date
  durationDays Int?
  owner String
  category String
  description String
  comment String
  actor String
  resolvedBy String?
  previousStatus String
  item RepairItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  @@index([owner, resolvedAt])
  @@index([itemId, startedAt])
}

model RepairDelivery {
  id String @id @default(uuid())
  itemId String @unique
  deliveredAt DateTime @db.Date
  recordedAt DateTime @default(now())
  actor String
  comment String
  item RepairItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  @@index([deliveredAt])
}

model RepairEvent {
  id Int @id @default(autoincrement())
  requestId String
  action String
  actor String
  recordedAt DateTime @default(now())
  revision Int
  detail Json
  snapshot Json
  request RepairRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  @@index([requestId, recordedAt, id])
  @@index([recordedAt, id])
}

model Spare {
  id             String @id
  sapNumber      String
  name           String
  description    String
  categoryId     String
  area           String
  drawingNumber  String
  drawingPdf     String?
  drawingPdfName String?
  referencePhoto String?
  comments       String
  createdAt      String
  updatedAt      String
  uncoveredAt    String?
  owner          Area @relation(fields: [area], references: [id], onDelete: Restrict)
  category       Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  equipment      SpareEquipment[]
  units          Unit[]
  history        History[]
  @@index([area])
  @@index([sapNumber])
}

model SpareEquipment {
  spareId     String
  equipmentId String
  spare       Spare @relation(fields: [spareId], references: [id], onDelete: Cascade)
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  @@id([spareId, equipmentId])
}

model Unit {
  id                   String @id
  spareTypeId          String
  status               String
  statusSince          String
  comment              String
  location             String
  installedEquipmentId String?
  installationDate     String?
  sapNotice            String?
  repairStartDate      String?
  solp                 String?
  purchaseOrder        String?
  eta                  String?
  photo                String?
  spare                Spare @relation(fields: [spareTypeId], references: [id], onDelete: Cascade)
  equipment            Equipment? @relation(fields: [installedEquipmentId], references: [id], onDelete: Restrict)
  @@index([spareTypeId])
  @@index([status])
}

model History {
  id             String @id
  unitId         String
  spareTypeId    String
  timestamp      String
  user           String
  previousStatus String?
  nextStatus     String
  equipmentId    String?
  comment        String
  snapshot       Json
  spare          Spare @relation(fields: [spareTypeId], references: [id], onDelete: Cascade)
  // Historical IDs intentionally survive removal of units/equipment.
  @@index([spareTypeId, timestamp])
}

model AuditLog {
  id        String @id @default(uuid())
  user      String
  entity    String
  entityId  String
  action    String
  field     String
  oldValue  Json?
  newValue  Json?
  createdAt DateTime @default(now())
  @@index([entity, entityId, createdAt])
  @@map("audit_log")
}

model LcoConfig {
  id Int @id
  revision Int @default(0)
  staleDays Int @default(90)
  veryStaleDays Int @default(180)
  recentDays Int @default(30)
  dueDays Int @default(60)
  oldDays Int @default(90)
  migratedLegacyFingerprints String[] @default([])
}

model LcoCage {
  id String @id
  cageNumber Int @unique
  side String
  assetId String?
  shafts LcoShaft[]
}

model LcoShaft {
  id String @id
  cageId String
  position String
  cage LcoCage @relation(fields: [cageId], references: [id], onDelete: Restrict)
  couplings LcoCoupling[]
  events LcoEvent[]
  @@unique([cageId, position])
}

model LcoCoupling {
  id String @id
  shaftId String
  side String
  shaft LcoShaft @relation(fields: [shaftId], references: [id], onDelete: Restrict)
  readings LcoReading[]
  events LcoEvent[]
  photos LcoPhoto[]
  @@unique([shaftId, side])
}

model LcoEvent {
  id String @id
  type String
  date String
  createdAt String
  updatedAt String?
  deletedAt DateTime?
  inspector String @default("")
  observations String?
  couplingId String?
  shaftId String?
  reason String?
  sapWorkOrder String?
  notes String?
  wearAtRemoval Int?
  coupling LcoCoupling? @relation(fields: [couplingId], references: [id], onDelete: Restrict)
  shaft LcoShaft? @relation(fields: [shaftId], references: [id], onDelete: Restrict)
  readings LcoReading[]
  photos LcoPhoto[]
  versions LcoEventVersion[]
  @@index([date, createdAt])
  @@index([couplingId, date])
  @@index([shaftId, date])
}

model LcoReading {
  eventId String
  couplingId String
  ordinal Int
  wearLevel Int
  note String
  conditionCode String?
  event LcoEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  coupling LcoCoupling @relation(fields: [couplingId], references: [id], onDelete: Restrict)
  @@id([eventId, couplingId])
  @@index([couplingId])
}

model LcoPhoto {
  eventId String
  scope String
  ordinal Int
  id String
  couplingId String?
  fileName String
  mimeType String
  dataUrl String
  createdAt String
  caption String
  event LcoEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  coupling LcoCoupling? @relation(fields: [couplingId], references: [id], onDelete: Restrict)
  @@id([eventId, scope, ordinal])
}

model LcoEventVersion {
  id String @id @default(uuid())
  eventId String
  revision Int
  action String
  actor String
  snapshot Json
  recordedAt DateTime @default(now())
  event LcoEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  @@unique([eventId, revision])
}

model LcoImportReceipt {
  hash String @id
  eventCount Int
  revision Int
  createdAt DateTime @default(now())
}

model RexConfig {
  id Int @id
  revision Int @default(0)
  hoursPerDay Decimal @default(9) @db.Decimal(6, 3)
  hourlyRate Decimal? @db.Decimal(18, 4)
  currency String @default("USD")
}

model RexTask {
  id String @id @default(uuid())
  code String @default("")
  line String @default("LC1C")
  areaId String
  equipmentId String?
  name String
  description String @default("")
  specialty String
  impact String @default("")
  criticality String
  active Boolean @default(true)
  frequencyType String
  intervalMonths Int?
  frequencyCriteria String @default("")
  referenceOt String @default("")
  technicalPlan String @default("")
  controlData String @default("")
  justification String @default("")
  interventionTime String @default("")
  resources Json @default("{}")
  estimates RexEstimate[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String
  area Area @relation(fields: [areaId], references: [id], onDelete: Restrict)
  equipment Equipment? @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  scope RexTaskScopeItem[]
  documents RexTaskDocument[]
  executions RexExecution[]
  @@index([areaId, active])
  @@index([specialty, criticality])
  @@index([equipmentId])
}

model RexTaskScopeItem {
  id String @id @default(uuid())
  taskId String
  description String
  ordinal Int
  required Boolean @default(true)
  quantity Decimal @db.Decimal(14, 3)
  unit String
  notes String @default("")
  active Boolean @default(true)
  task RexTask @relation(fields: [taskId], references: [id], onDelete: Restrict)
  executionItems RexExecutionItem[]
  @@index([taskId, active, ordinal])
}

model RexTaskDocument {
  id String @id @default(uuid())
  taskId String
  name String
  path String
  type String @default("")
  notes String @default("")
  task RexTask @relation(fields: [taskId], references: [id], onDelete: Restrict)
  @@index([taskId])
}

model RexEvent {
  id String @id @default(uuid())
  name String
  type String
  startDate DateTime? @db.Date
  endDate DateTime? @db.Date
  exercise Int?
  status String
  notes String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String
  executions RexExecution[]
  @@index([exercise, status])
}

model RexExecution {
  id String @id @default(uuid())
  taskId String
  eventId String?
  intent String
  status String
  startedAt DateTime? @db.Date
  performedAt DateTime? @db.Date
  ot String @default("")
  notes String @default("")
  responsibleId String?
  source String @default("MANUAL")
  taskSnapshot Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String
  task RexTask @relation(fields: [taskId], references: [id], onDelete: Restrict)
  event RexEvent? @relation(fields: [eventId], references: [id], onDelete: Restrict)
  responsible Responsible? @relation(fields: [responsibleId], references: [id], onDelete: Restrict)
  items RexExecutionItem[]
  resolutions RexPendingResolution[]
  @@index([taskId, performedAt, id])
  @@index([eventId, status])
  @@index([status, performedAt])
  @@index([responsibleId])
}

model RexExecutionItem {
  id String @id @default(uuid())
  executionId String
  scopeItemId String?
  description String
  ordinal Int
  required Boolean
  quantity Decimal @db.Decimal(14, 3)
  completed Decimal @db.Decimal(14, 3)
  unit String
  status String
  reason String @default("")
  notes String @default("")
  execution RexExecution @relation(fields: [executionId], references: [id], onDelete: Restrict)
  scopeItem RexTaskScopeItem? @relation(fields: [scopeItemId], references: [id], onDelete: Restrict)
  pending RexPending?
  resolution RexPendingResolution?
  @@index([executionId, ordinal])
  @@index([scopeItemId])
}

model RexPending {
  id String @id @default(uuid())
  originItemId String @unique
  quantity Decimal @db.Decimal(14, 3)
  reason String
  notes String
  originDate DateTime? @db.Date
  createdAt DateTime @default(now())
  originItem RexExecutionItem @relation(fields: [originItemId], references: [id], onDelete: Restrict)
  resolutions RexPendingResolution[]
}

model RexPendingResolution {
  id String @id @default(uuid())
  pendingId String
  executionId String
  itemId String @unique
  quantity Decimal @db.Decimal(14, 3)
  performedAt DateTime? @db.Date
  createdAt DateTime @default(now())
  createdBy String
  pending RexPending @relation(fields: [pendingId], references: [id], onDelete: Restrict)
  execution RexExecution @relation(fields: [executionId], references: [id], onDelete: Restrict)
  item RexExecutionItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  @@index([pendingId])
  @@index([executionId])
}

model RexEstimate {
  id Int @id @default(autoincrement())
  taskId String
  durationDays Decimal @db.Decimal(10, 3)
  mechanical Decimal @db.Decimal(8, 0)
  electrical Decimal @db.Decimal(8, 0)
  mro Decimal @db.Decimal(20, 2)
  services Decimal @db.Decimal(20, 2)
  ownLabor Decimal @db.Decimal(20, 2)
  hoursPerDay Decimal @db.Decimal(6, 3)
  hourlyRate Decimal @db.Decimal(18, 4)
  currency String
  people Decimal @db.Decimal(9, 0)
  hoursPerPerson Decimal @db.Decimal(18, 6)
  manHours Decimal @db.Decimal(24, 6)
  contractorLabor Decimal @db.Decimal(30, 2)
  total Decimal @db.Decimal(30, 2)
  createdAt DateTime @default(now())
  createdBy String
  task RexTask @relation(fields: [taskId], references: [id], onDelete: Restrict)
  @@index([taskId, id])
}

# Copiar a .env. No usar este valor de ejemplo en producción.
POSTGRES_DB=critical_spares
POSTGRES_USER=spares
POSTGRES_PASSWORD=CHANGE_ME_BEFORE_START
APP_PORT=8080
APP_BIND_ADDRESS=0.0.0.0
# Desarrollo fuera de Docker: PostgreSQL accesible solo desde la máquina local.
# Si el password contiene caracteres especiales, codificarlo para URL.
DATABASE_URL=postgresql://spares:CHANGE_ME_BEFORE_START@127.0.0.1:5432/critical_spares
PORT=3001
HOST=127.0.0.1
